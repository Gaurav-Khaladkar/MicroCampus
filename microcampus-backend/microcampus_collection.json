{
  "info": {
    "_postman_id": "f9d9184c-8234-4c94-b64e-37113b23317a",
    "name": "MicroCampus Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "AUTH",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@gmail.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if(data.token) {",
                  "   pm.environment.set(\"token\", data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@gmail.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "COURSES",
      "item": [
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/courses"
          }
        },
        {
          "name": "Create Course (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Data Structures\",\n  \"description\": \"DSA Course\",\n  \"instructor\": \"Prof. X\"\n}"
            },
            "url": "{{base_url}}/api/courses"
          }
        }
      ]
    },
    {
      "name": "NOTES",
      "item": [
        {
          "name": "Get All Notes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/notes"
          }
        },
        {
          "name": "Create Note (with Quiz)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Stacks and Queues\",\n  \"content\": \"Notes on stacks and queues...\",\n  \"course\": \"Data Structures\",\n  \"status\": \"approved\",\n  \"quiz\": {\n    \"questions\": [\n      { \"q\": \"Stack is LIFO?\", \"options\": [\"True\", \"False\"], \"correctIndex\": 0 },\n      { \"q\": \"Queue is FIFO?\", \"options\": [\"True\", \"False\"], \"correctIndex\": 0 }\n    ]\n  }\n}"
            },
            "url": "{{base_url}}/api/notes"
          }
        },
        {
          "name": "Get Note by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/notes/{{noteId}}"
          }
        }
      ]
    },
    {
      "name": "QUIZ ATTEMPT",
      "item": [
        {
          "name": "Submit Quiz",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [0, 0]\n}"
            },
            "url": "{{base_url}}/api/quiz/attempt/{{noteId}}"
          }
        },
        {
          "name": "Get My Quiz Attempts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/quiz/attempt"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "noteId", "value": "" },
    { "key": "token", "value": "" }
  ]
}
